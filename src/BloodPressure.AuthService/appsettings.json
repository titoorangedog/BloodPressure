{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=BloodPressure;User Id=sa;Password=Your_password123;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "BloodPressure",
    "Audience": "BloodPressure.Client",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_KEY",
    "AccessTokenMinutes": 60
  },
  "GoogleOAuth": {
    "ClientId": "GOOGLE_CLIENT_ID",
    "ClientSecret": "GOOGLE_CLIENT_SECRET",
    "CallbackUrl": "http://localhost:7001/auth/callback"
  },
  "WebClient": {
    "BaseUrl": "http://localhost:5172"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5172"
    ]
  },
  "ClinicalThresholds": {
    "Systolic": {
      "VeryLowMax": 90,
      "LowMax": 100,
      "NormalMax": 130,
      "HighMax": 150
    },
    "Diastolic": {
      "VeryLowMax": 60,
      "LowMax": 70,
      "NormalMax": 85,
      "HighMax": 95
    }
  }
}
