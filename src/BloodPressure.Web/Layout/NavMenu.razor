@using System.Security.Claims
@using BloodPressure.Shared.Auth
@using BloodPressure.Shared.Domain
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject BloodPressure.Web.Services.AuthService AuthService
@using BloodPressure.Web.Shared

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BloodPressure</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-item px-3">
                    <div class="nav-link">
                        <div>@GetEmail(authState.User)</div>
                        <small>Ruolo: @GetRole(authState.User)</small>
                    </div>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="readings">
                        Rilevazioni
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="readings/new">
                        Nuova rilevazione
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        Grafici
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="settings">
                        Impostazioni
                    </NavLink>
                </div>
                @if (IsAdmin(authState.User))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin">
                            Admin
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </nav>
    <div class="nav-item px-3 mt-3">
        <LicenseBanner />
    </div>
    <div class="nav-item px-3 mt-3">
        <AuthorizeView>
            <Authorized>
                <button class="btn btn-outline-primary w-100" @onclick="AuthService.LogoutAsync">Logout</button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="btn btn-outline-primary w-100" href="login">
                    Login
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool isSubscribed;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        if (!isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
            isSubscribed = true;
        }
    }

    // Fix: Change signature to match expected delegate (void return type)
    private void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        InvokeAsync(StateHasChanged);
    }

    private static bool IsAdmin(ClaimsPrincipal user)
        => user.GetUserRole() == UserRole.Admin;

    private static string GetEmail(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Email)?.Value
            ?? user.FindFirst("email")?.Value
            ?? user.Identity?.Name
            ?? "Utente";
    }

    private static string GetRole(ClaimsPrincipal user)
        => user.GetUserRole().ToString();

    public void Dispose()
    {
        if (isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }
    }
}
