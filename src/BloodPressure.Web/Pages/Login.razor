@page "/login"
@attribute [AllowAnonymous]
@inject BloodPressure.Web.Services.AuthService AuthService
@inject BloodPressure.Web.Services.LocalizationService LocalizationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<h1>@T("login.title", "Login")</h1>

@if (ShowExpiredMessage)
{
    <div class="alert alert-warning" role="alert">
        @T("login.sessionExpired", "Sessione scaduta, effettua di nuovo l'accesso.")
    </div>
}

@if (IsEmbeddedBrowser)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("login.embeddedBrowser.title", "Browser non supportato")</strong><br />
        @T("login.embeddedBrowser.message", "Per accedere con Google apri l'app in un browser esterno (Chrome, Edge o Safari).")
    </div>
}

<div class="form-check mb-3">
    <InputCheckbox id="rememberLogin" class="form-check-input" @bind-Value="RememberLogin" />
    <label class="form-check-label" for="rememberLogin">@T("login.rememberMe", "Ricorda autenticazione,")</label>
</div>

<button class="btn btn-primary" @onclick="StartLogin" disabled="@IsEmbeddedBrowser">@T("login.google", "Accedi con Google")</button>

@code {
    private bool ShowExpiredMessage { get; set; }
    private bool RememberLogin { get; set; }
    private bool IsEmbeddedBrowser { get; set; }
    private bool isLocalizationSubscribed;

    protected override void OnInitialized()
    {
        if (!isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged += OnLanguageChanged;
            isLocalizationSubscribed = true;
        }

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = ParseQuery(uri.Query);
        ShowExpiredMessage = query.TryGetValue("reason", out var value) &&
            string.Equals(value, "expired", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        IsEmbeddedBrowser = await JS.InvokeAsync<bool>("bpAuth.isEmbeddedBrowser");
        await InvokeAsync(StateHasChanged);
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(query))
        {
            return result;
        }

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kvp = part.Split('=', 2);
            if (kvp.Length == 2)
            {
                result[Uri.UnescapeDataString(kvp[0])] = Uri.UnescapeDataString(kvp[1]);
            }
        }

        return result;
    }

    private async Task StartLogin()
    {
        if (IsEmbeddedBrowser)
        {
            return;
        }

        await AuthService.StartLoginAsync(RememberLogin, CancellationToken.None);
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string T(string key, string fallback) => LocalizationService.T(key, fallback);

    public void Dispose()
    {
        if (isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged -= OnLanguageChanged;
        }
    }
}
