@page "/admin"
@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@using BloodPressure.Shared.Auth
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.ToastService ToastService
@inject BloodPressure.Web.Services.LocalizationService LocalizationService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<h1>@T("admin.title", "Admin")</h1>

@if (IsLoading)
{
    <p>@T("common.loading", "Caricamento...")</p>
}
else if (!string.IsNullOrWhiteSpace(AccessError))
{
    <div class="alert alert-warning">@AccessError</div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@T("admin.table.email", "Email")</th>
            <th>@T("admin.table.role", "Ruolo")</th>
            <th>@T("admin.table.license", "Licenza")</th>
            <th>@T("admin.table.expiry", "Scadenza")</th>
            <th>@T("admin.table.actions", "Azioni")</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <InputSelect class="form-select" @bind-Value="user.Role">
                        @foreach (var role in Enum.GetValues<UserRole>())
                        {
                            <option value="@role">@role</option>
                        }
                    </InputSelect>
                </td>
                <td>@user.ActiveLicense</td>
                <td>@FormatLicenseEndDate(user.ActiveLicense, user.LicenseEndDateUtc)</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => SaveRole(user)" disabled="@IsSavingRole(user.Id)">
                        @if (IsSavingRole(user.Id))
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>@T("common.saving", "Salvataggio...")</span>
                        }
                        else
                        {
                            <span>@T("admin.actions.saveRole", "Salva ruolo")</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenLicense(user)">@T("admin.actions.license", "Licenza")</button>
                    <button class="btn btn-sm btn-outline-info ms-2" @onclick="() => ShowLicenses(user)">@T("admin.actions.licenseHistory", "Storico licenze")</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (ShowLicenseEditor && SelectedUser is not null)
{
    <div class="card p-3">
        <h3>@T("admin.assign.title", "Assegna licenza a") @SelectedUser.Email</h3>
        <div class="mb-3">
            <label class="form-label">@T("admin.assign.type", "Tipo")</label>
            <InputSelect class="form-select" @bind-Value="LicenseType">
                @foreach (var type in Enum.GetValues<LicenseType>())
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">@T("admin.assign.start", "Inizio")</label>
            <InputDate class="form-control bp-datepicker" @bind-Value="LicenseStart" />
        </div>
        <div class="mb-3">
            <label class="form-label">@T("admin.assign.end", "Fine")</label>
            <InputDate class="form-control bp-datepicker" @bind-Value="LicenseEnd" />
        </div>
        <button class="btn btn-primary" @onclick="AssignLicense" disabled="@IsAssigningLicense">
            @if (IsAssigningLicense)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>@T("common.saving", "Salvataggio...")</span>
            }
            else
            {
                <span>@T("admin.assign.submit", "Assegna")</span>
            }
        </button>
    </div>
}

@if (ShowLicenseList && SelectedUserDetails is not null)
{
    <div class="card p-3 mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="mb-0">@T("admin.licensesOf", "Licenze di") @SelectedUserDetails.Email</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseLicenseList">@T("common.close", "Chiudi")</button>
        </div>
        <div class="mt-3">
            @if (SelectedUserDetails.Licenses.Count == 0)
            {
                <p>@T("admin.noLicenses", "Nessuna licenza trovata.")</p>
            }
            else
            {
                <table class="table table-sm table-striped">
                    <thead>
                    <tr>
                        <th>@T("admin.assign.type", "Tipo")</th>
                        <th>@T("admin.assign.start", "Inizio")</th>
                        <th>@T("admin.assign.end", "Fine")</th>
                        <th>@T("admin.table.active", "Attiva")</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var license in SelectedUserDetails.Licenses)
                    {
                        <tr>
                            @if (IsEditingActiveLicense && EditingLicenseId == license.Id)
                            {
                                <td>
                                    <InputSelect class="form-select form-select-sm" @bind-Value="EditLicenseType">
                                        @foreach (var type in Enum.GetValues<LicenseType>())
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </InputSelect>
                                </td>
                                <td>
                                    <InputDate class="form-control form-control-sm bp-datepicker" @bind-Value="EditLicenseStart" />
                                </td>
                                <td>
                                    <InputDate class="form-control form-control-sm bp-datepicker" @bind-Value="EditLicenseEnd" />
                                </td>
                                <td>@(license.IsActive ? T("common.yes", "Si") : T("common.no", "No"))</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary me-2" @onclick="() => SaveActiveLicense(license)" disabled="@IsSavingLicense(license.Id)">
                                        @if (IsSavingLicense(license.Id))
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            <span>@T("common.saving", "Salvataggio...")</span>
                                        }
                                        else
                                        {
                                            <span>@T("common.save", "Salva")</span>
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditActiveLicense" disabled="@IsSavingLicense(license.Id)">@T("common.cancel", "Annulla")</button>
                                </td>
                            }
                            else
                            {
                                <td>@license.Type</td>
                                <td>@license.StartDateUtc.ToLocalTime():g</td>
                                <td>@FormatLicenseEndDateTime(license.Type, license.EndDateUtc)</td>
                                <td>@(license.IsActive ? T("common.yes", "Si") : T("common.no", "No"))</td>
                                <td class="text-end">
                                    @if (license.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditActiveLicense(license)">@T("readings.actions.edit", "Modifica")</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private bool IsLoading { get; set; } = true;
    private string AccessError { get; set; } = string.Empty;
    private List<AdminUserModel> Users { get; set; } = new();

    private bool ShowLicenseEditor { get; set; }
    private AdminUserModel? SelectedUser { get; set; }
    private bool ShowLicenseList { get; set; }
    private UserDetailDto? SelectedUserDetails { get; set; }
    private bool IsEditingActiveLicense { get; set; }
    private bool IsAssigningLicense { get; set; }
    private HashSet<Guid> SavingRoleUserIds { get; } = new();
    private HashSet<Guid> SavingLicenseIds { get; } = new();
    private Guid? EditingLicenseId { get; set; }
    private LicenseType EditLicenseType { get; set; } = LicenseType.Free;
    private DateTime EditLicenseStart { get; set; } = DateTime.Today;
    private DateTime EditLicenseEnd { get; set; } = DateTime.Today.AddDays(30);
    private LicenseType LicenseType { get; set; } = LicenseType.Advanced;
    private DateTime LicenseStart { get; set; } = DateTime.Today;
    private DateTime LicenseEnd { get; set; } = DateTime.Today.AddDays(30);
    private bool isLocalizationSubscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged += OnLanguageChanged;
            isLocalizationSubscribed = true;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.GetUserRole() != UserRole.Admin)
        {
            AccessError = T("admin.accessDenied", "Accesso riservato agli amministratori.");
            IsLoading = false;
            return;
        }

        try
        {
            var users = await ReadApiClient.GetUsersAsync(CancellationToken.None);
            Users = users.Select(AdminUserModel.FromDto).ToList();
        }
        catch (Exception ex)
        {
            AccessError = $"{T("admin.loadErrorPrefix", "Errore nel caricamento admin")}: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveRole(AdminUserModel user)
    {
        if (!SavingRoleUserIds.Add(user.Id))
        {
            return;
        }

        try
        {
            await ReadApiClient.AssignRoleAsync(user.Id, new AssignRoleRequest { Role = user.Role }, CancellationToken.None);
            ToastService.Show(T("common.saveSuccess", "Salvataggio completato"), ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show(T("common.saveError", "Errore in fase di salvataggio"), ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
        finally
        {
            SavingRoleUserIds.Remove(user.Id);
        }
    }

    private void OpenLicense(AdminUserModel user)
    {
        SelectedUser = user;
        ShowLicenseEditor = true;
    }

    private async Task ShowLicenses(AdminUserModel user)
    {
        try
        {
            SelectedUserDetails = await ReadApiClient.GetUserAsync(user.Id, CancellationToken.None);
            ShowLicenseList = true;
            IsEditingActiveLicense = false;
            EditingLicenseId = null;
        }
        catch (Exception ex)
        {
            ToastService.Show(T("admin.licenseLoadError", "Errore nel caricamento licenze"), ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
    }

    private void CloseLicenseList()
    {
        ShowLicenseList = false;
        SelectedUserDetails = null;
        IsEditingActiveLicense = false;
        EditingLicenseId = null;
    }

    private void EditActiveLicense(LicenseDto license)
    {
        if (!license.IsActive)
        {
            return;
        }

        IsEditingActiveLicense = true;
        EditingLicenseId = license.Id;
        EditLicenseType = license.Type;
        EditLicenseStart = license.StartDateUtc.ToLocalTime().DateTime;
        EditLicenseEnd = license.EndDateUtc.ToLocalTime().DateTime;
    }

    private void CancelEditActiveLicense()
    {
        IsEditingActiveLicense = false;
        EditingLicenseId = null;
    }

    private async Task SaveActiveLicense(LicenseDto license)
    {
        if (SelectedUserDetails is null)
        {
            return;
        }

        if (!SavingLicenseIds.Add(license.Id))
        {
            return;
        }

        try
        {
            await ReadApiClient.UpdateLicenseAsync(SelectedUserDetails.Id, license.Id, new LicenseUpdateRequest
            {
                Type = EditLicenseType,
                StartDateUtc = new DateTimeOffset(DateTime.SpecifyKind(EditLicenseStart, DateTimeKind.Local)).ToUniversalTime(),
                EndDateUtc = new DateTimeOffset(DateTime.SpecifyKind(EditLicenseEnd, DateTimeKind.Local)).ToUniversalTime()
            }, CancellationToken.None);

            ToastService.Show(T("common.saveSuccess", "Salvataggio completato"), ToastLevel.Success);
            SelectedUserDetails = await ReadApiClient.GetUserAsync(SelectedUserDetails.Id, CancellationToken.None);
            IsEditingActiveLicense = false;
            EditingLicenseId = null;
        }
        catch (Exception ex)
        {
            ToastService.Show(T("common.saveError", "Errore in fase di salvataggio"), ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
        finally
        {
            SavingLicenseIds.Remove(license.Id);
        }
    }
    private async Task AssignLicense()
    {
        if (SelectedUser is null)
        {
            return;
        }

        if (IsAssigningLicense)
        {
            return;
        }

        IsAssigningLicense = true;
        try
        {
            await ReadApiClient.AssignLicenseAsync(SelectedUser.Id, new AssignLicenseRequest
            {
                Type = LicenseType,
                StartDateUtc = new DateTimeOffset(DateTime.SpecifyKind(LicenseStart, DateTimeKind.Local)).ToUniversalTime(),
                EndDateUtc = new DateTimeOffset(DateTime.SpecifyKind(LicenseEnd, DateTimeKind.Local)).ToUniversalTime()
            }, CancellationToken.None);
            await ReloadUsersAsync();
            ToastService.Show(T("common.saveSuccess", "Salvataggio completato"), ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show(T("common.saveError", "Errore in fase di salvataggio"), ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
        finally
        {
            IsAssigningLicense = false;
        }
    }

    private async Task ReloadUsersAsync()
    {
        var users = await ReadApiClient.GetUsersAsync(CancellationToken.None);
        Users = users.Select(AdminUserModel.FromDto).ToList();

        if (SelectedUser is not null)
        {
            SelectedUser = Users.FirstOrDefault(x => x.Id == SelectedUser.Id);
        }
    }

    private bool IsSavingRole(Guid userId) => SavingRoleUserIds.Contains(userId);
    private bool IsSavingLicense(Guid licenseId) => SavingLicenseIds.Contains(licenseId);

    private string FormatLicenseEndDate(LicenseType type, DateTimeOffset endUtc)
    {
        return type == LicenseType.Premium ? T("admin.unlimited", "Illimitata") : endUtc.ToLocalTime().ToString("d");
    }

    private string FormatLicenseEndDateTime(LicenseType type, DateTimeOffset endUtc)
    {
        return type == LicenseType.Premium ? T("admin.unlimited", "Illimitata") : endUtc.ToLocalTime().ToString("g");
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged -= OnLanguageChanged;
        }
    }

    private string T(string key, string fallback) => LocalizationService.T(key, fallback);

    private sealed class AdminUserModel
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = string.Empty;
        public UserRole Role { get; set; }
        public LicenseType ActiveLicense { get; set; }
        public DateTimeOffset LicenseEndDateUtc { get; set; }

        public static AdminUserModel FromDto(UserSummaryDto dto)
        {
            return new AdminUserModel
            {
                Id = dto.Id,
                Email = dto.Email,
                Role = dto.Role,
                ActiveLicense = dto.ActiveLicense,
                LicenseEndDateUtc = dto.LicenseEndDateUtc
            };
        }
    }
}

