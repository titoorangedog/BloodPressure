    private string T(string key, string fallback) => LocalizationService.T(key, fallback);

    private static readonly CultureInfo CetCulture = CultureInfo.GetCultureInfo("it-IT");
    private const string CetDateFormat = "dd/MM/yyyy";
    private const string CetTimeFormat = "HH:mm";

    private static TimeZoneInfo GetCetTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Rome");
        }
        catch
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById("Central European Standard Time");
            }
            catch
            {
                return TimeZoneInfo.Local;
            }
        }
    }

    private static DateTimeOffset ToCet(DateTimeOffset utc)
        => TimeZoneInfo.ConvertTime(utc, GetCetTimeZone());

    private static (DateTimeOffset FromUtc, DateTimeOffset ToUtc) BuildUtcRange(DateOnly fromDate, DateOnly toDate)
    {
        var timeZone = GetCetTimeZone();
        var fromLocal = fromDate.ToDateTime(TimeOnly.MinValue);
        var toLocal = toDate.ToDateTime(TimeOnly.MaxValue);
        var fromUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(fromLocal, DateTimeKind.Unspecified), timeZone);
        var toUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(toLocal, DateTimeKind.Unspecified), timeZone);
        return (new DateTimeOffset(fromUtc), new DateTimeOffset(toUtc));
    }

    private string? GetMinFilterFromDateAttribute()
    {
        if (ActiveLicenseType != LicenseType.Free)
        {
            return null;
        }

        var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
        return todayCet.AddDays(-30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static string FormatCetDate(DateTimeOffset utc)
        => ToCet(utc).ToString(CetDateFormat, CetCulture);

    private static string FormatCetTime(DateTimeOffset utc)
        => ToCet(utc).ToString(CetTimeFormat, CetCulture);

    private static DayPart GetDayPart(TimeSpan time, IReadOnlyCollection<TimeSlotDefinitionDto> definitions)
    {
        foreach (var definition in definitions)
        {
            if (!TryParseTime(definition.Start, out var start) || !TryParseTime(definition.End, out var end))
            {
                continue;
            }

            if (IsWithinRange(time, start, end))
            {
                return GetDayPartFromKey(definition.Key);
            }
        }

        return DayPart.Night;
    }

    private string GetDayPartLabel(DayPart part)
    {
        return part switch
        {
            DayPart.Morning => T("daypart.morning", "Mattino"),
            DayPart.Midday => T("daypart.midday", "Mezzo giorno"),
            DayPart.Afternoon => T("daypart.afternoon", "Pomeriggio"),
            DayPart.Evening => T("daypart.evening", "Sera"),
            DayPart.Night => T("daypart.night", "Notte"),
            _ => T("daypart.undefined", "Non definito")
        };
    }

    private static DayPart GetDayPartFromKey(string? key) => key?.Trim().ToLowerInvariant() switch
    {
        "morning" => DayPart.Morning,
        "midday" => DayPart.Midday,
        "afternoon" => DayPart.Afternoon,
        "evening" => DayPart.Evening,
        "night" => DayPart.Night,
        _ => DayPart.Night
    };

    private static bool IsWithinRange(TimeSpan time, TimeSpan start, TimeSpan end)
    {
        if (end < start)
        {
            return time >= start || time <= end;
        }

        return time >= start && time <= end;
    }

    private IReadOnlyCollection<TimeSlotDefinitionDto> GetDefinitions()
    {
        return TimeSlotDefinitions.Count == 0
            ? new[]
            {
                new TimeSlotDefinitionDto { Key = "Morning", Label = "Mattino", Start = "06:00", End = "10:59" },
                new TimeSlotDefinitionDto { Key = "Midday", Label = "Mezzo giorno", Start = "11:00", End = "14:59" },
                new TimeSlotDefinitionDto { Key = "Afternoon", Label = "Pomeriggio", Start = "15:00", End = "19:59" },
                new TimeSlotDefinitionDto { Key = "Evening", Label = "Sera", Start = "20:00", End = "23:59" },
                new TimeSlotDefinitionDto { Key = "Night", Label = "Notte", Start = "00:00", End = "05:59" }
            }
            : TimeSlotDefinitions;
    }

    private static bool TryParseTime(string? value, out TimeSpan time)
    {
        time = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        if (TimeSpan.TryParseExact(trimmed, "hh\\:mm", CultureInfo.InvariantCulture, out time))
        {
            return true;
        }

        if (TimeSpan.TryParseExact(trimmed, "HH\\:mm", CultureInfo.InvariantCulture, out time))
        {
            return true;
        }

        return false;
    }

