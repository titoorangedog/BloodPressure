    private static string GetClinicalBandClass(ClinicalBand band)
    {
        return band switch
        {
            ClinicalBand.VeryLow => "bg-danger text-white",
            ClinicalBand.Low => "bg-warning text-dark",
            ClinicalBand.NormalLow => "bg-primary text-white",
            ClinicalBand.NormalOptimal => "bg-success text-white",
            ClinicalBand.High => "bg-warning text-dark",
            ClinicalBand.VeryHigh => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    private ThresholdSetDto GetSystolicThresholds()
        => Thresholds?.Systolic ?? DefaultSystolicThresholds;

    private ThresholdSetDto GetDiastolicThresholds()
        => Thresholds?.Diastolic ?? DefaultDiastolicThresholds;

    private ClinicalBand ClassifySystolicBand(int value)
        => ClassifyBand(value, GetSystolicThresholds());

    private ClinicalBand ClassifyDiastolicBand(int value)
        => ClassifyBand(value, GetDiastolicThresholds());

    private static ClinicalBand ClassifyBand(int value, ThresholdSetDto thresholds)
    {
        if (value <= thresholds.VeryLowMax) return ClinicalBand.VeryLow;
        if (value <= thresholds.LowMax) return ClinicalBand.Low;
        if (value <= thresholds.NormalLowMax) return ClinicalBand.NormalLow;
        if (value <= thresholds.NormalOptimalMax) return ClinicalBand.NormalOptimal;
        if (value <= thresholds.WarningHighMax) return ClinicalBand.High;
        if (value >= thresholds.VeryHighMin) return ClinicalBand.VeryHigh;
        return ClinicalBand.High;
    }

    private string GetClinicalBandLabel(ClinicalBand band)
    {
        return band switch
        {
            ClinicalBand.VeryLow => T("settings.thresholds.veryLow", "PERICOLO BASSA"),
            ClinicalBand.Low => T("settings.thresholds.low", "WARNING BASSA"),
            ClinicalBand.NormalLow => T("settings.thresholds.normalLow", "NORMALE BASSA"),
            ClinicalBand.NormalOptimal => T("settings.thresholds.normalOptimal", "NORMALE OTTIMALE"),
            ClinicalBand.High => T("settings.thresholds.highWarning", "WARNING ALTA (borderline)"),
            ClinicalBand.VeryHigh => T("settings.thresholds.veryHigh", "PERICOLO ALTA"),
            _ => band.ToString()
        };
    }

    private enum ClinicalBand
    {
        VeryLow,
        Low,
        NormalLow,
        NormalOptimal,
        High,
        VeryHigh
    }
