@page "/readings"
@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.WriteApiClient WriteApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1>Rilevazioni</h1>

<style>
    .day-separator td {
        border-top: 2px solid #6c757d;
    }

    .panel-close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        border: 0;
        background: transparent;
        color: #212529;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0;
    }
</style>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-primary" @onclick="CreateNew">Nuova rilevazione</button>
    <button class="btn btn-outline-primary" @onclick="ToggleExportPanel">Esporta dati</button>
    <button class="btn btn-outline-secondary" @onclick="ToggleImportPanel">Importa dati</button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Filtro periodo</h5>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">Data inizio</label>
                <InputDate class="form-control" @bind-Value="FilterFromDate" disabled="@IsApplyingFilter" min="@GetMinFilterFromDateAttribute()" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Data fine</label>
                <InputDate class="form-control" @bind-Value="FilterToDate" disabled="@IsApplyingFilter" />
            </div>
            <div class="col-12 col-md-4">
                <button class="btn btn-primary w-100" @onclick="ApplyDateFilterAsync" disabled="@IsApplyingFilter">
                    @if (IsApplyingFilter)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Filtra
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(InfoMessage))
{
    <div class="alert alert-info" role="alert">@InfoMessage</div>
}

@if (ErrorMessages.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>Import fallito.</strong>
        <ul class="mb-0">
            @foreach (var error in ErrorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success" role="alert">@SuccessMessage</div>
}

@if (ShowExportPanel)
{
    <div class="card mb-3">
        <div class="card-body position-relative">
            <button type="button"
                    class="panel-close"
                    aria-label="Chiudi pannello export"
                    @onclick="HideExportPanel">&times;</button>
            <h5 class="card-title">Esporta rilevazioni</h5>
            <p class="card-text">Scarica tutte le rilevazioni in formato Excel o XML.</p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-success" @onclick="ExportExcel">Scarica Excel</button>
                <button class="btn btn-outline-success" @onclick="ExportXml">Scarica XML</button>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-outline-secondary" @onclick="DownloadTemplateExcel">Template Excel</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadTemplateXml">Template XML</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadExampleExcel">Esempio compilato Excel</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadExampleXml">Esempio compilato XML</button>
            </div>
        </div>
    </div>
}

@if (ShowImportPanel)
{
    <div class="card mb-3">
        <div class="card-body position-relative">
            <button type="button"
                    class="panel-close"
                    aria-label="Chiudi pannello import"
                    @onclick="HideImportPanel">&times;</button>
            <h5 class="card-title">Importa rilevazioni</h5>
            <p class="card-text">Carica un file Excel o XML con tutte le informazioni delle rilevazioni.</p>
            <div class="mb-3">
                <h6 class="mb-2">Campi richiesti</h6>
                <ul class="mb-0">
                    <li>DateUtc</li>
                    <li>TimeUtc</li>
                    <li>Systolic</li>
                    <li>Diastolic</li>
                </ul>
                <div class="mt-2 small text-muted">
                    Gli altri campi sono facoltativi. Per opzioni puoi usare gli ID oppure i nomi (TimeSlotName, SportActivityName, SymptomOptionNames).
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="mb-2">Excel</h6>
                        <InputFile OnChange="HandleExcelSelected" accept=".xlsx,.xls" class="form-control" />
                        <button class="btn btn-primary mt-2" @onclick="ImportExcel" disabled="@(!CanImportExcel || IsImportingExcel)">
                            @if (IsImportingExcel)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Carica Excel
                        </button>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="mb-2">XML</h6>
                        <InputFile OnChange="HandleXmlSelected" accept=".xml" class="form-control" />
                        <button class="btn btn-primary mt-2" @onclick="ImportXml" disabled="@(!CanImportXml || IsImportingXml)">
                            @if (IsImportingXml)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Carica XML
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <p>Caricamento...</p>
}
else if (ReadingItems.Count == 0)
{
    <p>Nessuna rilevazione trovata.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Data</th>
            <th>Ora</th>
            <th>Fascia</th>
            <th>Sistolica</th>
            <th>Diastolica</th>
            <th>FC</th>
            <th>Peso</th>
            <th>Severita</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @{
            DateOnly? previousDate = null;
        }
        @foreach (var reading in ReadingItems)
        {
            var currentDate = DateOnly.FromDateTime(ToCet(reading.TimestampUtc).DateTime);
            var isNewDay = previousDate.HasValue && previousDate.Value != currentDate;
            previousDate = currentDate;
            <tr class="@(isNewDay ? "day-separator" : string.Empty)">
                <td>@FormatCetDate(reading.TimestampUtc)</td>
                <td>@FormatCetTime(reading.TimestampUtc)</td>
                <td class="align-middle">
                    <span class="d-inline-flex align-items-center gap-2 lh-1">
                        @GetDayPartIcon(GetDayPart(ToCet(reading.TimestampUtc).TimeOfDay, GetDefinitions()))
                        <span class="lh-1">@GetTimeSlotLabel(reading)</span>
                    </span>
                </td>
                <td>@reading.Systolic</td>
                <td>@reading.Diastolic</td>
                <td>@reading.HeartRate</td>
                <td>@reading.WeightKg</td>
                <td>
                    <span class="badge me-2 @GetSeverityClass(ClassifyValue(reading.Systolic, Thresholds.Systolic))">
                        S: @ClassifyValue(reading.Systolic, Thresholds.Systolic)
                    </span>
                    <span class="badge @GetSeverityClass(ClassifyValue(reading.Diastolic, Thresholds.Diastolic))">
                        D: @ClassifyValue(reading.Diastolic, Thresholds.Diastolic)
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-secondary me-2 d-inline-flex align-items-center gap-1" @onclick="() => Edit(reading.Id)" aria-label="Modifica rilevazione" title="Modifica">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25Zm2.92 2.33H5v-.92l9.06-9.06.92.92L5.92 19.58ZM20.71 7.04a1 1 0 0 0 0-1.41L18.37 3.3a1 1 0 0 0-1.41 0l-1.5 1.5 3.75 3.75 1.5-1.51Z"/>
                        </svg>
                        <span>Modifica</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" @onclick="() => RequestDelete(reading)" aria-label="Elimina rilevazione" title="Elimina">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9ZM7 9h2v9H7V9Zm-1 12h12a2 2 0 0 0 2-2V8H4v11a2 2 0 0 0 2 2Z"/>
                        </svg>
                        <span>Elimina</span>
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<div class="modal fade" id="deleteReadingModal" tabindex="-1" aria-labelledby="deleteReadingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReadingModalLabel">Conferma eliminazione</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <p>Vuoi eliminare definitivamente la rilevazione selezionata?</p>
                @if (PendingDeleteTimestampUtc.HasValue)
                {
                    <div class="text-muted small">Data: @FormatCetDate(PendingDeleteTimestampUtc.Value)</div>
                    <div class="text-muted small">Ora: @FormatCetTime(PendingDeleteTimestampUtc.Value)</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Elimina</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReadingResponse> ReadingItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool ShowExportPanel { get; set; }
    private bool ShowImportPanel { get; set; }
    private List<TimeSlotDefinitionDto> TimeSlotDefinitions { get; set; } = new();
    private ClinicalThresholdsDto Thresholds { get; set; } = new()
    {
        Systolic = new ThresholdSetDto
        {
            VeryLowMax = 79,
            LowMax = 99,
            NormalLowMax = 109,
            NormalOptimalMax = 120,
            WarningHighMax = 139,
            VeryHighMin = 180
        },
        Diastolic = new ThresholdSetDto
        {
            VeryLowMax = 49,
            LowMax = 59,
            NormalLowMax = 69,
            NormalOptimalMax = 80,
            WarningHighMax = 89,
            VeryHighMin = 120
        }
    };
    private string? InfoMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private List<string> ErrorMessages { get; set; } = new();
    private IBrowserFile? ExcelFile { get; set; }
    private IBrowserFile? XmlFile { get; set; }
    private bool IsImportingExcel { get; set; }
    private bool IsImportingXml { get; set; }
    private bool IsApplyingFilter { get; set; }
    private Guid? PendingDeleteId { get; set; }
    private DateTimeOffset? PendingDeleteTimestampUtc { get; set; }
    private DateOnly FilterFromDate { get; set; }
    private DateOnly FilterToDate { get; set; }
    private LicenseType? ActiveLicenseType { get; set; }

    private bool IsImportingAny => IsImportingExcel || IsImportingXml;
    private bool CanImportExcel => ExcelFile is not null && !IsImportingAny;
    private bool CanImportXml => XmlFile is not null && !IsImportingAny;

    protected override async Task OnInitializedAsync()
    {
        var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
        var license = await ReadApiClient.GetLicenseAsync(CancellationToken.None);
        ActiveLicenseType = license?.Type;

        var minFromDate = ActiveLicenseType == LicenseType.Free ? todayCet.AddDays(-30) : todayCet.AddDays(-180);
        FilterFromDate = minFromDate;
        FilterToDate = todayCet;

        var settings = await ReadApiClient.GetSettingsAsync(CancellationToken.None);
        TimeSlotDefinitions = settings.TimeSlotDefinitions.ToList();
        Thresholds = settings.Thresholds;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        var (fromUtc, toUtc) = BuildUtcRange(FilterFromDate, FilterToDate);
        var results = await ReadApiClient.GetReadingsAsync(fromUtc, toUtc, CancellationToken.None);
        ReadingItems = results.ToList();
        IsLoading = false;
    }

    private async Task ApplyDateFilterAsync()
    {
        if (IsApplyingFilter)
        {
            return;
        }

        if (FilterFromDate > FilterToDate)
        {
            ClearMessages();
            InfoMessage = "La data di inizio deve essere precedente o uguale alla data di fine.";
            return;
        }

        if (ActiveLicenseType == LicenseType.Free)
        {
            var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
            var minFromDate = todayCet.AddDays(-30);
            if (FilterFromDate < minFromDate)
            {
                FilterFromDate = minFromDate;
                ClearMessages();
                InfoMessage = "Con licenza Free puoi visualizzare solo le rilevazioni degli ultimi 30 giorni.";
            }
        }

        IsApplyingFilter = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            IsApplyingFilter = false;
        }
    }

    private void CreateNew() => Navigation.NavigateTo("/readings/new");

    private void Edit(Guid id) => Navigation.NavigateTo($"/readings/{id}");

    private async Task RequestDelete(ReadingResponse reading)
    {
        PendingDeleteId = reading.Id;
        PendingDeleteTimestampUtc = reading.TimestampUtc;
        await JS.InvokeVoidAsync("bpModal.show", "deleteReadingModal");
    }

    private async Task ConfirmDelete()
    {
        if (!PendingDeleteId.HasValue)
        {
            return;
        }

        await WriteApiClient.DeleteReadingAsync(PendingDeleteId.Value, CancellationToken.None);
        await LoadAsync();
        PendingDeleteId = null;
        PendingDeleteTimestampUtc = null;
        await JS.InvokeVoidAsync("bpModal.hide", "deleteReadingModal");
    }

    private void ToggleExportPanel()
    {
        ShowExportPanel = !ShowExportPanel;
        if (ShowExportPanel)
        {
            ShowImportPanel = false;
        }
        ClearMessages();
    }

    private void HideExportPanel()
    {
        ShowExportPanel = false;
    }

    private void ToggleImportPanel()
    {
        ShowImportPanel = !ShowImportPanel;
        if (ShowImportPanel)
        {
            ShowExportPanel = false;
        }
        ClearMessages();
    }

    private void HideImportPanel()
    {
        ShowImportPanel = false;
    }

    private void ExportExcel()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetExportExcelUrl(), true);
    }

    private void ExportXml()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetExportXmlUrl(), true);
    }

    private void DownloadTemplateExcel()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetTemplateExcelUrl(), true);
    }

    private void DownloadTemplateXml()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetTemplateXmlUrl(), true);
    }

    private void DownloadExampleExcel()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetExampleExcelUrl(), true);
    }

    private void DownloadExampleXml()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetExampleXmlUrl(), true);
    }

    private void HandleExcelSelected(InputFileChangeEventArgs args)
    {
        ExcelFile = args.FileCount > 0 ? args.File : null;
        ClearMessages();
    }

    private void HandleXmlSelected(InputFileChangeEventArgs args)
    {
        XmlFile = args.FileCount > 0 ? args.File : null;
        ClearMessages();
    }

    private async Task ImportExcel()
    {
        if (ExcelFile is null)
        {
            ClearMessages();
            InfoMessage = "Seleziona un file Excel.";
            return;
        }

        ClearMessages();
        IsImportingExcel = true;
        try
        {
            var result = await WriteApiClient.ImportExcelAsync(ExcelFile, CancellationToken.None);
            SuccessMessage = $"Import completato. Inserite: {result.ImportedCount}. Duplicati ignorati: {result.SkippedDuplicates}. Totale: {result.TotalCount}.";
            await LoadAsync();
        }
        catch (ImportException ex)
        {
            ErrorMessages = ex.Errors;
        }
        catch (Exception ex)
        {
            InfoMessage = ex.Message;
        }
        finally
        {
            IsImportingExcel = false;
        }
    }

    private async Task ImportXml()
    {
        if (XmlFile is null)
        {
            ClearMessages();
            InfoMessage = "Seleziona un file XML.";
            return;
        }

        ClearMessages();
        IsImportingXml = true;
        try
        {
            var result = await WriteApiClient.ImportXmlAsync(XmlFile, CancellationToken.None);
            SuccessMessage = $"Import completato. Inserite: {result.ImportedCount}. Duplicati ignorati: {result.SkippedDuplicates}. Totale: {result.TotalCount}.";
            await LoadAsync();
        }
        catch (ImportException ex)
        {
            ErrorMessages = ex.Errors;
        }
        catch (Exception ex)
        {
            InfoMessage = ex.Message;
        }
        finally
        {
            IsImportingXml = false;
        }
    }

    private void ClearMessages()
    {
        InfoMessage = null;
        SuccessMessage = null;
        ErrorMessages = new List<string>();
    }

    private string GetTimeSlotLabel(ReadingResponse reading)
    {
        return GetDayPartLabel(GetDayPart(ToCet(reading.TimestampUtc).TimeOfDay, GetDefinitions()));
    }

    private static readonly CultureInfo CetCulture = CultureInfo.GetCultureInfo("it-IT");
    private const string CetDateFormat = "dd/MM/yyyy";
    private const string CetTimeFormat = "HH:mm";

    private static TimeZoneInfo GetCetTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Rome");
        }
        catch
        {
            try
            {
                return TimeZoneInfo.FindSystemTimeZoneById("Central European Standard Time");
            }
            catch
            {
                return TimeZoneInfo.Local;
            }
        }
    }

    private static DateTimeOffset ToCet(DateTimeOffset utc)
        => TimeZoneInfo.ConvertTime(utc, GetCetTimeZone());

    private static (DateTimeOffset FromUtc, DateTimeOffset ToUtc) BuildUtcRange(DateOnly fromDate, DateOnly toDate)
    {
        var timeZone = GetCetTimeZone();
        var fromLocal = fromDate.ToDateTime(TimeOnly.MinValue);
        var toLocal = toDate.ToDateTime(TimeOnly.MaxValue);
        var fromUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(fromLocal, DateTimeKind.Unspecified), timeZone);
        var toUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(toLocal, DateTimeKind.Unspecified), timeZone);
        return (new DateTimeOffset(fromUtc), new DateTimeOffset(toUtc));
    }

    private string? GetMinFilterFromDateAttribute()
    {
        if (ActiveLicenseType != LicenseType.Free)
        {
            return null;
        }

        var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
        return todayCet.AddDays(-30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static string FormatCetDate(DateTimeOffset utc)
        => ToCet(utc).ToString(CetDateFormat, CetCulture);

    private static string FormatCetTime(DateTimeOffset utc)
        => ToCet(utc).ToString(CetTimeFormat, CetCulture);

    private static DayPart GetDayPart(TimeSpan time, IReadOnlyCollection<TimeSlotDefinitionDto> definitions)
    {
        foreach (var definition in definitions)
        {
            if (!TryParseTime(definition.Start, out var start) || !TryParseTime(definition.End, out var end))
            {
                continue;
            }

            if (IsWithinRange(time, start, end))
            {
                return GetDayPartFromKey(definition.Key);
            }
        }

        return DayPart.Night;
    }

    private string GetDayPartLabel(DayPart part)
    {
        var definition = GetDefinitions().FirstOrDefault(d => GetDayPartFromKey(d.Key) == part);
        if (!string.IsNullOrWhiteSpace(definition?.Label))
        {
            return definition!.Label;
        }

        return part switch
        {
            DayPart.Morning => "Mattino",
            DayPart.Midday => "Mezzo giorno",
            DayPart.Afternoon => "Pomeriggio",
            DayPart.Evening => "Sera",
            DayPart.Night => "Notte",
            _ => "Non definito"
        };
    }

    private static DayPart GetDayPartFromKey(string? key) => key?.Trim().ToLowerInvariant() switch
    {
        "morning" => DayPart.Morning,
        "midday" => DayPart.Midday,
        "afternoon" => DayPart.Afternoon,
        "evening" => DayPart.Evening,
        "night" => DayPart.Night,
        _ => DayPart.Night
    };

    private static bool IsWithinRange(TimeSpan time, TimeSpan start, TimeSpan end)
    {
        if (end < start)
        {
            return time >= start || time <= end;
        }

        return time >= start && time <= end;
    }

    private IReadOnlyCollection<TimeSlotDefinitionDto> GetDefinitions()
    {
        return TimeSlotDefinitions.Count == 0
            ? new[]
            {
                new TimeSlotDefinitionDto { Key = "Morning", Label = "Mattino", Start = "06:00", End = "10:59" },
                new TimeSlotDefinitionDto { Key = "Midday", Label = "Mezzo giorno", Start = "11:00", End = "14:59" },
                new TimeSlotDefinitionDto { Key = "Afternoon", Label = "Pomeriggio", Start = "15:00", End = "19:59" },
                new TimeSlotDefinitionDto { Key = "Evening", Label = "Sera", Start = "20:00", End = "23:59" },
                new TimeSlotDefinitionDto { Key = "Night", Label = "Notte", Start = "00:00", End = "05:59" }
            }
            : TimeSlotDefinitions;
    }

    private static bool TryParseTime(string? value, out TimeSpan time)
    {
        time = default;
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        if (TimeSpan.TryParseExact(trimmed, "hh\\:mm", CultureInfo.InvariantCulture, out time))
        {
            return true;
        }

        if (TimeSpan.TryParseExact(trimmed, "HH\\:mm", CultureInfo.InvariantCulture, out time))
        {
            return true;
        }

        return false;
    }

    private static MarkupString GetDayPartIcon(DayPart part)
    {
        var svg = part switch
        {
            DayPart.Morning => SvgSunrise,
            DayPart.Midday => SvgNoon,
            DayPart.Afternoon => SvgSunset,
            DayPart.Evening => SvgBed,
            DayPart.Night => SvgNight,
            _ => SvgNoon
        };
        return new MarkupString(svg);
    }

    private const string SvgSunrise =
        "<svg width='18' height='18' viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M3 18h18v2H3v-2Zm9-10a5 5 0 0 0-5 5h10a5 5 0 0 0-5-5Zm-1-6h2v4h-2V2Zm-6.36 3.64 1.41-1.41 2.83 2.83-1.41 1.41-2.83-2.83Zm13.9-1.41 1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83Z'/></svg>";

    private const string SvgNoon =
        "<svg width='18' height='18' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='5' fill='currentColor'/><path fill='currentColor' d='M11 2h2v4h-2V2Zm0 16h2v4h-2v-4Zm10-7v2h-4v-2h4ZM7 12v2H3v-2h4Zm9.19-6.19 1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83ZM6.23 16.23l1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83Z'/></svg>";

    private const string SvgSunset =
        "<svg width='18' height='18' viewBox='0 0 24 24' aria-hidden='true'><path fill='currentColor' d='M3 18h18v2H3v-2Zm9-5a5 5 0 0 0-5 5h10a5 5 0 0 0-5-5Zm-1-11h2v4h-2V2Zm-6.36 3.64 1.41-1.41 2.83 2.83-1.41 1.41-2.83-2.83Zm13.9-1.41 1.41 1.41-2.83 2.83-1.41-1.41 2.83-2.83Z'/></svg>";

    private const string SvgBed =
