@page "/readings"
@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.WriteApiClient WriteApiClient
@inject BloodPressure.Web.Services.LocalizationService LocalizationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<h1>@T("readings.title", "Rilevazioni")</h1>

<style>
    .day-separator td {
        border-top: 2px solid #6c757d;
    }

    .panel-close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        border: 0;
        background: transparent;
        color: #212529;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0;
    }

    .reading-mobile-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        background: var(--bs-body-bg);
        overflow-x: hidden;
    }

    .reading-mobile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
        gap: 0.5rem 0.75rem;
    }

    .reading-mobile-field {
        min-width: 0;
    }

    .reading-mobile-label {
        font-size: 0.8rem;
        color: var(--bs-secondary-color);
        margin-bottom: 0.1rem;
    }

    .reading-mobile-value {
        font-size: 0.95rem;
        line-height: 1.25;
        word-break: break-word;
    }

    .reading-mobile-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .reading-mobile-actions .btn {
        flex: 1 1 auto;
    }

    .reading-mobile-severity {
        display: grid;
        grid-template-columns: 1fr;
        justify-items: start;
        gap: 0.35rem;
    }

    .reading-mobile-severity .badge {
        margin-right: 0 !important;
        max-width: 100%;
        width: fit-content;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .reading-mobile-field-severity {
        grid-column: 1 / -1;
    }

    @@media (max-width: 767.98px) {
        .bp-period-filter-row {
            display: grid !important;
            grid-template-columns: 1fr;
            align-items: stretch;
        }

        .bp-period-filter-field {
            min-width: 0;
        }

        .bp-period-filter-action {
            width: 100%;
        }

        .reading-mobile-actions {
            flex-direction: column;
        }
    }

</style>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-primary" @onclick="CreateNew">@T("readings.new", "Nuova rilevazione")</button>
    <button class="btn btn-outline-primary" @onclick="ToggleExportPanel">@T("readings.exportData", "Esporta dati")</button>
    <button class="btn btn-outline-secondary" @onclick="ToggleImportPanel">@T("readings.importData", "Importa dati")</button>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@T("readings.filter.title", "Filtro periodo")</h5>
        <div class="bp-period-filter-row">
            <div class="bp-period-filter-field">
                <label class="form-label">@T("readings.filter.from", "Data inizio")</label>
                <InputDate class="form-control bp-datepicker" @bind-Value="FilterFromDate" disabled="@IsApplyingFilter" min="@GetMinFilterFromDateAttribute()" />
            </div>
            <div class="bp-period-filter-field">
                <label class="form-label">@T("readings.filter.to", "Data fine")</label>
                <InputDate class="form-control bp-datepicker" @bind-Value="FilterToDate" disabled="@IsApplyingFilter" />
            </div>
            <div class="bp-period-filter-action">
                <button class="btn btn-primary w-100" @onclick="ApplyDateFilterAsync" disabled="@IsApplyingFilter">
                    @if (IsApplyingFilter)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    @T("readings.filter.apply", "Filtra")
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(InfoMessage))
{
    <div class="alert alert-info" role="alert">@InfoMessage</div>
}

@if (ErrorMessages.Count > 0)
{
    <div class="alert alert-danger" role="alert">
        <strong>@T("readings.import.failed", "Import fallito.")</strong>
        <ul class="mb-0">
            @foreach (var error in ErrorMessages)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success" role="alert">@SuccessMessage</div>
}

@if (ShowExportPanel)
{
    <div class="card mb-3">
        <div class="card-body position-relative">
            <button type="button"
                    class="panel-close"
                    aria-label="@T("readings.export.closePanel", "Chiudi pannello export")"
                    @onclick="HideExportPanel">&times;</button>
            <h5 class="card-title">@T("readings.export.title", "Esporta rilevazioni")</h5>
            <p class="card-text">@T("readings.export.description", "Scarica tutte le rilevazioni in formato Excel o XML.")</p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-success" @onclick="ExportExcel">@T("readings.export.downloadExcel", "Scarica Excel")</button>
                <button class="btn btn-outline-success" @onclick="ExportXml">@T("readings.export.downloadXml", "Scarica XML")</button>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button class="btn btn-outline-secondary" @onclick="DownloadTemplateExcel">@T("readings.export.templateExcel", "Template Excel")</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadTemplateXml">@T("readings.export.templateXml", "Template XML")</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadExampleExcel">@T("readings.export.exampleExcel", "Esempio compilato Excel")</button>
                <button class="btn btn-outline-secondary" @onclick="DownloadExampleXml">@T("readings.export.exampleXml", "Esempio compilato XML")</button>
            </div>
        </div>
    </div>
}

@if (ShowImportPanel)
{
    <div class="card mb-3">
        <div class="card-body position-relative">
            <button type="button"
                    class="panel-close"
                    aria-label="@T("readings.import.closePanel", "Chiudi pannello import")"
                    @onclick="HideImportPanel">&times;</button>
            <h5 class="card-title">@T("readings.import.title", "Importa rilevazioni")</h5>
            <p class="card-text">@T("readings.import.description", "Carica un file Excel o XML con tutte le informazioni delle rilevazioni.")</p>
            <div class="mb-3">
                <h6 class="mb-2">@T("readings.import.requiredFields", "Campi richiesti")</h6>
                <ul class="mb-0">
                    <li>DateUtc</li>
                    <li>TimeUtc</li>
                    <li>Systolic</li>
                    <li>Diastolic</li>
                </ul>
                <div class="mt-2 small text-muted">
                    @T("readings.import.optionalFieldsHint", "Gli altri campi sono facoltativi. Per opzioni puoi usare gli ID oppure i nomi (TimeSlotName, SportActivityName, SymptomOptionNames).")
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="mb-2">Excel</h6>
                        <InputFile OnChange="HandleExcelSelected" accept=".xlsx,.xls" class="form-control" />
                        <button class="btn btn-primary mt-2" @onclick="ImportExcel" disabled="@(!CanImportExcel || IsImportingExcel)">
                            @if (IsImportingExcel)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @T("readings.import.uploadExcel", "Carica Excel")
                        </button>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="border rounded p-3 h-100">
                        <h6 class="mb-2">XML</h6>
                        <InputFile OnChange="HandleXmlSelected" accept=".xml" class="form-control" />
                        <button class="btn btn-primary mt-2" @onclick="ImportXml" disabled="@(!CanImportXml || IsImportingXml)">
                            @if (IsImportingXml)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @T("readings.import.uploadXml", "Carica XML")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <p>@T("common.loading", "Caricamento...")</p>
}
else if (ReadingItems.Count == 0)
{
    <p>@T("readings.empty", "Nessuna rilevazione trovata.")</p>
}
else
{
    <div class="small text-muted mb-2">@T("readings.count", "Totale rilevazioni"): @ReadingItems.Count</div>

    <div class="readings-desktop bp-readings-desktop">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>@T("readings.table.date", "Data")</th>
                <th>@T("readings.table.time", "Ora")</th>
                <th>@T("readings.table.timeslot", "Fascia")</th>
                <th>@T("readings.table.systolic", "Sistolica")</th>
                <th>@T("readings.table.diastolic", "Diastolica")</th>
                <th>@T("readings.table.heartRate", "FC")</th>
                <th>@T("readings.table.weight", "Peso")</th>
                <th>@T("readings.table.severity", "Severita")</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @{
                DateOnly? previousDate = null;
            }
            @foreach (var reading in ReadingItems)
            {
                var currentDate = DateOnly.FromDateTime(ToCet(reading.TimestampUtc).DateTime);
                var isNewDay = previousDate.HasValue && previousDate.Value != currentDate;
                previousDate = currentDate;
                <tr class="@(isNewDay ? "day-separator" : string.Empty)">
                    <td>@FormatCetDate(reading.TimestampUtc)</td>
                    <td>@FormatCetTime(reading.TimestampUtc)</td>
                    <td class="align-middle">
                        <span class="d-inline-flex align-items-center gap-2 lh-1">
                            @GetDayPartIcon(GetDayPart(ToCet(reading.TimestampUtc).TimeOfDay, GetDefinitions()))
                            <span class="lh-1">@GetTimeSlotLabel(reading)</span>
                        </span>
                    </td>
                    <td>@reading.Systolic</td>
                    <td>@reading.Diastolic</td>
                    <td>@reading.HeartRate</td>
                    <td>@reading.WeightKg</td>
                    <td>
                        @{
                            var systolicBand = ClassifySystolicBand(reading.Systolic);
                            var diastolicBand = ClassifyDiastolicBand(reading.Diastolic);
                        }
                        <span class="badge me-2 @GetClinicalBandClass(systolicBand)">
                            S: @GetClinicalBandLabel(systolicBand)
                        </span>
                        <span class="badge @GetClinicalBandClass(diastolicBand)">
                            D: @GetClinicalBandLabel(diastolicBand)
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary me-2 d-inline-flex align-items-center gap-1" @onclick="() => Edit(reading.Id)" aria-label="@T("readings.actions.editAria", "Modifica rilevazione")" title="@T("readings.actions.edit", "Modifica")">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25Zm2.92 2.33H5v-.92l9.06-9.06.92.92L5.92 19.58ZM20.71 7.04a1 1 0 0 0 0-1.41L18.37 3.3a1 1 0 0 0-1.41 0l-1.5 1.5 3.75 3.75 1.5-1.51Z"/>
                            </svg>
                            <span>@T("readings.actions.edit", "Modifica")</span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" @onclick="() => RequestDelete(reading)" aria-label="@T("readings.actions.deleteAria", "Elimina rilevazione")" title="@T("readings.actions.delete", "Elimina")">
                            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9ZM7 9h2v9H7V9Zm-1 12h12a2 2 0 0 0 2-2V8H4v11a2 2 0 0 0 2 2Z"/>
                            </svg>
                            <span>@T("readings.actions.delete", "Elimina")</span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="readings-mobile bp-readings-mobile">
        @foreach (var reading in ReadingItems)
        {
            var dayPart = GetDayPart(ToCet(reading.TimestampUtc).TimeOfDay, GetDefinitions());
            var systolicBand = ClassifySystolicBand(reading.Systolic);
            var diastolicBand = ClassifyDiastolicBand(reading.Diastolic);
            <article class="reading-mobile-card">
                <div class="reading-mobile-grid">
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.date", "Data")</div>
                        <div class="reading-mobile-value">@FormatCetDate(reading.TimestampUtc)</div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.time", "Ora")</div>
                        <div class="reading-mobile-value">@FormatCetTime(reading.TimestampUtc)</div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.timeslot", "Fascia")</div>
                        <div class="reading-mobile-value d-inline-flex align-items-center gap-2">
                            @GetDayPartIcon(dayPart)
                            <span>@GetTimeSlotLabel(reading)</span>
                        </div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.systolic", "Sistolica")</div>
                        <div class="reading-mobile-value">@reading.Systolic</div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.diastolic", "Diastolica")</div>
                        <div class="reading-mobile-value">@reading.Diastolic</div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.heartRate", "FC")</div>
                        <div class="reading-mobile-value">@reading.HeartRate</div>
                    </div>
                    <div class="reading-mobile-field">
                        <div class="reading-mobile-label">@T("readings.table.weight", "Peso")</div>
                        <div class="reading-mobile-value">@reading.WeightKg</div>
                    </div>
                    <div class="reading-mobile-field reading-mobile-field-severity">
                        <div class="reading-mobile-label">@T("readings.table.severity", "Severita")</div>
                        <div class="reading-mobile-value reading-mobile-severity">
                            <span class="badge me-2 @GetClinicalBandClass(systolicBand)">
                                S: @GetClinicalBandLabel(systolicBand)
                            </span>
                            <span class="badge @GetClinicalBandClass(diastolicBand)">
                                D: @GetClinicalBandLabel(diastolicBand)
                            </span>
                        </div>
                    </div>
                </div>
                <div class="reading-mobile-actions">
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" @onclick="() => Edit(reading.Id)" aria-label="@T("readings.actions.editAria", "Modifica rilevazione")" title="@T("readings.actions.edit", "Modifica")">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25Zm2.92 2.33H5v-.92l9.06-9.06.92.92L5.92 19.58ZM20.71 7.04a1 1 0 0 0 0-1.41L18.37 3.3a1 1 0 0 0-1.41 0l-1.5 1.5 3.75 3.75 1.5-1.51Z"/>
                        </svg>
                        <span>@T("readings.actions.edit", "Modifica")</span>
                    </button>
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center gap-1" @onclick="() => RequestDelete(reading)" aria-label="@T("readings.actions.deleteAria", "Elimina rilevazione")" title="@T("readings.actions.delete", "Elimina")">
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6h2v9h-2V9Zm4 0h2v9h-2V9ZM7 9h2v9H7V9Zm-1 12h12a2 2 0 0 0 2-2V8H4v11a2 2 0 0 0 2 2Z"/>
                        </svg>
                        <span>@T("readings.actions.delete", "Elimina")</span>
                    </button>
                </div>
            </article>
        }
    </div>
}

<div class="modal fade" id="deleteReadingModal" tabindex="-1" aria-labelledby="deleteReadingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReadingModalLabel">@T("readings.deleteModal.title", "Conferma eliminazione")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T("common.close", "Chiudi")"></button>
            </div>
            <div class="modal-body">
                <p>@T("readings.deleteModal.confirmText", "Vuoi eliminare definitivamente la rilevazione selezionata?")</p>
                @if (PendingDeleteTimestampUtc.HasValue)
                {
                    <div class="text-muted small">@T("readings.table.date", "Data"): @FormatCetDate(PendingDeleteTimestampUtc.Value)</div>
                    <div class="text-muted small">@T("readings.table.time", "Ora"): @FormatCetTime(PendingDeleteTimestampUtc.Value)</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("common.cancel", "Annulla")</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">@T("readings.actions.delete", "Elimina")</button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ReadingResponse> ReadingItems { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool ShowExportPanel { get; set; }
    private bool ShowImportPanel { get; set; }
    private List<TimeSlotDefinitionDto> TimeSlotDefinitions { get; set; } = new();
    private static readonly ThresholdSetDto DefaultSystolicThresholds = new()
    {
        VeryLowMax = 79,
        LowMax = 99,
        NormalLowMax = 109,
        NormalOptimalMax = 120,
        WarningHighMax = 139,
        VeryHighMin = 180
    };

    private static readonly ThresholdSetDto DefaultDiastolicThresholds = new()
    {
        VeryLowMax = 49,
        LowMax = 59,
        NormalLowMax = 69,
        NormalOptimalMax = 80,
        WarningHighMax = 89,
        VeryHighMin = 120
    };

    private static readonly ClinicalThresholdsDto DefaultThresholds = new()
    {
        Systolic = DefaultSystolicThresholds,
        Diastolic = DefaultDiastolicThresholds
    };

    private ClinicalThresholdsDto? Thresholds { get; set; } = DefaultThresholds;
    private string? InfoMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private List<string> ErrorMessages { get; set; } = new();
    private IBrowserFile? ExcelFile { get; set; }
    private IBrowserFile? XmlFile { get; set; }
    private bool IsImportingExcel { get; set; }
    private bool IsImportingXml { get; set; }
    private bool IsApplyingFilter { get; set; }
    private Guid? PendingDeleteId { get; set; }
    private DateTimeOffset? PendingDeleteTimestampUtc { get; set; }
    private DateOnly FilterFromDate { get; set; }
    private DateOnly FilterToDate { get; set; }
    private LicenseType? ActiveLicenseType { get; set; }
    private bool isLocalizationSubscribed;

    private bool IsImportingAny => IsImportingExcel || IsImportingXml;
    private bool CanImportExcel => ExcelFile is not null && !IsImportingAny;
    private bool CanImportXml => XmlFile is not null && !IsImportingAny;

    protected override async Task OnInitializedAsync()
    {
        if (!isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged += OnLanguageChanged;
            isLocalizationSubscribed = true;
        }

        var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
        try
        {
            var license = await ReadApiClient.GetLicenseAsync(CancellationToken.None);
            ActiveLicenseType = license?.Type;
        }
        catch
        {
            ActiveLicenseType = null;
        }

        var minFromDate = ActiveLicenseType == LicenseType.Free ? todayCet.AddDays(-30) : todayCet.AddDays(-180);
        FilterFromDate = minFromDate;
        FilterToDate = todayCet;

        try
        {
            var settings = await ReadApiClient.GetSettingsAsync(CancellationToken.None);
            TimeSlotDefinitions = settings.TimeSlotDefinitions.ToList();
            if (settings.Thresholds is not null &&
                settings.Thresholds.Systolic is not null &&
                settings.Thresholds.Diastolic is not null)
            {
                Thresholds = settings.Thresholds;
            }
        }
        catch
        {
            // Keep default thresholds/time slots so readings can still be loaded.
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        try
        {
            var (fromUtc, toUtc) = BuildUtcRange(FilterFromDate, FilterToDate);
            var results = await ReadApiClient.GetReadingsAsync(fromUtc, toUtc, CancellationToken.None);
            ReadingItems = results.ToList();

        }
        catch
        {
            ReadingItems = new List<ReadingResponse>();
            InfoMessage = T("readings.error.load", "Impossibile caricare le rilevazioni. Riprova.");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyDateFilterAsync()
    {
        if (IsApplyingFilter)
        {
            return;
        }

        if (FilterFromDate > FilterToDate)
        {
            ClearMessages();
            InfoMessage = T("common.dateRangeInvalid", "La data di inizio deve essere precedente o uguale alla data di fine.");
            return;
        }

        if (ActiveLicenseType == LicenseType.Free)
        {
            var todayCet = DateOnly.FromDateTime(ToCet(DateTimeOffset.UtcNow).DateTime);
            var minFromDate = todayCet.AddDays(-30);
            if (FilterFromDate < minFromDate)
            {
                FilterFromDate = minFromDate;
                ClearMessages();
                InfoMessage = T("readings.freeLimit.last30Days", "Con licenza Free puoi visualizzare solo le rilevazioni degli ultimi 30 giorni.");
            }
        }

        IsApplyingFilter = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            IsApplyingFilter = false;
        }
    }

    private void CreateNew() => Navigation.NavigateTo("/readings/new");

    private void Edit(Guid id) => Navigation.NavigateTo($"/readings/{id}");

    private async Task RequestDelete(ReadingResponse reading)
    {
        PendingDeleteId = reading.Id;
        PendingDeleteTimestampUtc = reading.TimestampUtc;
        await JS.InvokeVoidAsync("bpModal.show", "deleteReadingModal");
    }

    private async Task ConfirmDelete()
    {
        if (!PendingDeleteId.HasValue)
        {
            return;
        }

        await WriteApiClient.DeleteReadingAsync(PendingDeleteId.Value, CancellationToken.None);
        await LoadAsync();
        PendingDeleteId = null;
        PendingDeleteTimestampUtc = null;
        await JS.InvokeVoidAsync("bpModal.hide", "deleteReadingModal");
    }

    private void ToggleExportPanel()
    {
        ShowExportPanel = !ShowExportPanel;
        if (ShowExportPanel)
        {
            ShowImportPanel = false;
        }
        ClearMessages();
    }

    private void HideExportPanel()
    {
        ShowExportPanel = false;
    }

    private void ToggleImportPanel()
    {
        ShowImportPanel = !ShowImportPanel;
        if (ShowImportPanel)
        {
            ShowExportPanel = false;
        }
        ClearMessages();
    }

    private void HideImportPanel()
    {
        ShowImportPanel = false;
    }

    private void ExportExcel()
    {
        ClearMessages();
        Navigation.NavigateTo(ReadApiClient.GetExportExcelUrl(), true);
    }

