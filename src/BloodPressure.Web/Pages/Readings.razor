    private async Task ImportExcel()
    {
        if (ExcelFile is null)
        {
            ClearMessages();
            InfoMessage = T("readings.import.selectExcel", "Seleziona un file Excel.");
            return;
        }

        ClearMessages();
        IsImportingExcel = true;
        try
        {
            var result = await WriteApiClient.ImportExcelAsync(ExcelFile, CancellationToken.None);
            SuccessMessage = T("readings.import.success", "Import completato. Inserite: {0}. Duplicati ignorati: {1}. Totale: {2}.")
                .Replace("{0}", result.ImportedCount.ToString(CultureInfo.InvariantCulture))
                .Replace("{1}", result.SkippedDuplicates.ToString(CultureInfo.InvariantCulture))
                .Replace("{2}", result.TotalCount.ToString(CultureInfo.InvariantCulture));
            await LoadAsync();
        }
        catch (ImportException ex)
        {
            ErrorMessages = ex.Errors;
        }
        catch (Exception ex)
        {
            InfoMessage = ex.Message;
        }
        finally
        {
            IsImportingExcel = false;
        }
    }

