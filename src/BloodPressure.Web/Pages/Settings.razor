@page "/settings"
@using BloodPressure.Shared.Contracts
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.WriteApiClient WriteApiClient
@inject BloodPressure.Web.Services.ToastService ToastService
@inject IJSRuntime JS

<h1>Impostazioni utente</h1>

@if (IsLoading)
{
    <p>Caricamento...</p>
}
else
{
    <EditForm Model="@Model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h3>Dati anagrafici</h3>
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <InputText class="form-control" @bind-Value="Model.FirstName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Cognome</label>
            <InputText class="form-control" @bind-Value="Model.LastName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Genere</label>
            <InputText class="form-control" @bind-Value="Model.Gender" />
        </div>
        <div class="mb-3">
            <label class="form-label">Data di nascita</label>
            <InputDate class="form-control" @bind-Value="Model.DateOfBirth" />
        </div>
        <div class="mb-3">
            <label class="form-label">Altezza (cm)</label>
            <InputNumber class="form-control" @bind-Value="Model.HeightCm" />
        </div>

        <h3>Soglie cliniche</h3>
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th>Fascia</th>
                    <th>Sistolica (mmHg)</th>
                    <th>Diastolica (mmHg)</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td><span class="badge bg-danger">PERICOLO BASSA</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.VeryLowMax" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.VeryLowMax" /></td>
                </tr>
                <tr>
                    <td><span class="badge bg-warning text-dark">WARNING BASSA</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.LowMax" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.LowMax" /></td>
                </tr>
                <tr>
                    <td><span class="badge bg-primary">NORMALE BASSA</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.NormalLowMax" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.NormalLowMax" /></td>
                </tr>
                <tr>
                    <td><span class="badge bg-primary">NORMALE OTTIMALE</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.NormalOptimalMax" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.NormalOptimalMax" /></td>
                </tr>
                <tr>
                    <td><span class="badge bg-warning text-dark">WARNING ALTA (borderline)</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.WarningHighMax" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.WarningHighMax" /></td>
                </tr>
                <tr>
                    <td><span class="badge bg-danger">PERICOLO ALTA</span></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Systolic.VeryHighMin" /></td>
                    <td><InputNumber class="form-control" @bind-Value="Model.Diastolic.VeryHighMin" /></td>
                </tr>
                </tbody>
            </table>
        </div>

        <h3>Preferenze dashboard</h3>
        <div class="mb-3">
            <label class="form-label">Range predefinito (giorni)</label>
            <InputNumber class="form-control" @bind-Value="Model.DefaultRangeDays" />
        </div>

        <h3>Preferenze UI</h3>
        <div class="mb-3">
            <label class="form-label">Compact Mode</label>
            <InputCheckbox class="form-check-input" @bind-Value="Model.CompactMode" />
        </div>

        <h3 class="text-danger">Danger</h3>
        <div class="border border-danger rounded p-3 mb-3">
            <p class="mb-2">Questa azione elimina tutte le rilevazioni. Operazione irreversibile.</p>
            <button class="btn btn-danger" type="button" @onclick="OpenDeleteModal">
                Cancella tutte le rilevazioni
            </button>
        </div>

        <button class="btn btn-primary" type="submit" disabled="@IsSaving">
            @if (IsSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Salvataggio...</span>
            }
            else
            {
                <span>Salva</span>
            }
        </button>
    </EditForm>
}

<div class="modal fade" id="deleteReadingsModal" tabindex="-1" aria-labelledby="deleteReadingsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReadingsModalLabel">Conferma cancellazione</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi" @onclick="CloseDeleteModal"></button>
            </div>
            <div class="modal-body">
                <p>Vuoi cancellare tutte le rilevazioni?</p>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="DeleteConfirmChecked" id="confirmDeleteReadings" />
                    <label class="form-check-label" for="confirmDeleteReadings">
                        Confermo di voler eliminare tutte le rilevazioni
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal" disabled="@IsDeletingReadings">Annulla</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteReadings"
                        disabled="@(!DeleteConfirmChecked || IsDeletingReadings)">
                    @if (IsDeletingReadings)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Cancellazione...</span>
                    }
                    else
                    {
                        <span>Conferma</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private bool IsDeletingReadings { get; set; }
    private bool DeleteConfirmChecked { get; set; }
    private SettingsFormModel Model { get; set; } = SettingsFormModel.CreateDefault();

    protected override async Task OnInitializedAsync()
    {
        var settings = await ReadApiClient.GetSettingsAsync(CancellationToken.None);
        Model = SettingsFormModel.FromResponse(settings);
        IsLoading = false;
    }

    private async Task SaveAsync()
    {
        if (IsSaving)
        {
            return;
        }

        IsSaving = true;
        try
        {
            var request = Model.ToRequest();
            await ReadApiClient.UpdateSettingsAsync(request, CancellationToken.None);
            ToastService.Show("Salvataggio completato", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Errore in fase di salvataggio", ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task OpenDeleteModal()
    {
        DeleteConfirmChecked = false;
        IsDeletingReadings = false;
        await JS.InvokeVoidAsync("bpModal.show", "deleteReadingsModal");
    }

    private async Task CloseDeleteModal()
    {
        if (IsDeletingReadings)
        {
            return;
        }

        await JS.InvokeVoidAsync("bpModal.hide", "deleteReadingsModal");
    }

    private async Task ConfirmDeleteReadings()
    {
        if (!DeleteConfirmChecked || IsDeletingReadings)
        {
            return;
        }

        IsDeletingReadings = true;
        try
        {
            await WriteApiClient.DeleteAllReadingsAsync(CancellationToken.None);
            await JS.InvokeVoidAsync("bpModal.hide", "deleteReadingsModal");
            ToastService.Show("Rilevazioni cancellate", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Errore durante la cancellazione", ToastLevel.Error, 6000);
            ToastService.Show(ex.Message, ToastLevel.Error, 8000);
        }
        finally
        {
            IsDeletingReadings = false;
            DeleteConfirmChecked = false;
        }
    }

    private sealed class SettingsFormModel
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Gender { get; set; }
        public DateOnly? DateOfBirth { get; set; }
        public decimal? HeightCm { get; set; }

        public ThresholdSetFormModel Systolic { get; set; } = new();
        public ThresholdSetFormModel Diastolic { get; set; } = new();

        public int DefaultRangeDays { get; set; } = 30;
        public bool CompactMode { get; set; }
        public List<TimeSlotDefinitionFormModel> TimeSlotDefinitions { get; set; } = new();

        public static SettingsFormModel CreateDefault()
        {
            return new SettingsFormModel
            {
                Systolic = new ThresholdSetFormModel
                {
                    VeryLowMax = 79,
                    LowMax = 99,
                    NormalLowMax = 109,
                    NormalOptimalMax = 120,
                    WarningHighMax = 139,
                    VeryHighMin = 180
                },
                Diastolic = new ThresholdSetFormModel
                {
                    VeryLowMax = 49,
                    LowMax = 59,
                    NormalLowMax = 69,
                    NormalOptimalMax = 80,
                    WarningHighMax = 89,
                    VeryHighMin = 120
                },
                DefaultRangeDays = 30,
                CompactMode = false,
                TimeSlotDefinitions = TimeSlotDefinitionFormModel.BuildDefaults()
            };
        }

        public static SettingsFormModel FromResponse(UserSettingsResponse response)
        {
            return new SettingsFormModel
            {
                FirstName = response.FirstName,
                LastName = response.LastName,
                Gender = response.Gender,
                DateOfBirth = response.DateOfBirth,
                HeightCm = response.HeightCm,
                Systolic = ThresholdSetFormModel.FromDto(response.Thresholds.Systolic),
                Diastolic = ThresholdSetFormModel.FromDto(response.Thresholds.Diastolic),
                DefaultRangeDays = response.DashboardPreferences.DefaultRangeDays,
                CompactMode = response.UiPreferences.CompactMode,
                TimeSlotDefinitions = TimeSlotDefinitionFormModel.FromDto(response.TimeSlotDefinitions)
            };
        }

        public UserSettingsUpdateRequest ToRequest()
        {
            return new UserSettingsUpdateRequest
            {
                FirstName = FirstName,
                LastName = LastName,
                Gender = Gender,
                DateOfBirth = DateOfBirth,
                HeightCm = HeightCm,
                Thresholds = new ClinicalThresholdsDto
                {
                    Systolic = Systolic.ToDto(),
                    Diastolic = Diastolic.ToDto()
                },
                DashboardPreferences = new DashboardPreferencesDto { DefaultRangeDays = DefaultRangeDays },
                DefaultSelections = new DefaultSelectionsDto(),
                UiPreferences = new UiPreferencesDto { CompactMode = CompactMode },
                TimeSlotDefinitions = TimeSlotDefinitions.Select(TimeSlotDefinitionFormModel.ToDto).ToList()
            };
        }
    }

    private sealed class ThresholdSetFormModel
    {
        public int VeryLowMax { get; set; }
        public int LowMax { get; set; }
        public int NormalLowMax { get; set; }
        public int NormalOptimalMax { get; set; }
        public int WarningHighMax { get; set; }
        public int VeryHighMin { get; set; }

        public static ThresholdSetFormModel FromDto(ThresholdSetDto dto)
        {
            return new ThresholdSetFormModel
            {
                VeryLowMax = dto.VeryLowMax,
                LowMax = dto.LowMax,
                NormalLowMax = dto.NormalLowMax,
                NormalOptimalMax = dto.NormalOptimalMax,
                WarningHighMax = dto.WarningHighMax,
                VeryHighMin = dto.VeryHighMin
            };
        }

        public ThresholdSetDto ToDto()
        {
            return new ThresholdSetDto
            {
                VeryLowMax = VeryLowMax,
                LowMax = LowMax,
                NormalLowMax = NormalLowMax,
                NormalOptimalMax = NormalOptimalMax,
                WarningHighMax = WarningHighMax,
                VeryHighMin = VeryHighMin
            };
        }
    }

    private sealed class TimeSlotDefinitionFormModel
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Start { get; set; } = "00:00";
        public string End { get; set; } = "00:00";

        public static List<TimeSlotDefinitionFormModel> BuildDefaults()
        {
            return new List<TimeSlotDefinitionFormModel>
            {
                new() { Key = "Morning", Label = "Mattino", Start = "06:00", End = "10:59" },
                new() { Key = "Midday", Label = "Mezzo giorno", Start = "11:00", End = "14:59" },
                new() { Key = "Afternoon", Label = "Pomeriggio", Start = "15:00", End = "19:59" },
                new() { Key = "Evening", Label = "Sera", Start = "20:00", End = "23:59" },
                new() { Key = "Night", Label = "Notte", Start = "00:00", End = "05:59" }
            };
        }

        public static List<TimeSlotDefinitionFormModel> FromDto(IReadOnlyCollection<TimeSlotDefinitionDto> definitions)
        {
            if (definitions.Count == 0)
            {
                return BuildDefaults();
            }

            return definitions.Select(def => new TimeSlotDefinitionFormModel
            {
                Key = def.Key,
                Label = def.Label,
                Start = def.Start,
                End = def.End
            }).ToList();
        }

        public static TimeSlotDefinitionDto ToDto(TimeSlotDefinitionFormModel model)
        {
            return new TimeSlotDefinitionDto
            {
                Key = model.Key,
                Label = model.Label,
                Start = model.Start,
                End = model.End
            };
        }
    }
}
