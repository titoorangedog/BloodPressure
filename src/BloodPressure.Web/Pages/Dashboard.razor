@page "/dashboard"
@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject BloodPressure.Web.Services.StatsApiClient StatsApiClient
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.LocalizationService LocalizationService
@inject IJSRuntime Js
@implements IDisposable

<h1>@T("dashboard.title", "Dashboard")</h1>

@if (IsLoading)
{
    <p>@T("common.loading", "Caricamento...")</p>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Notice))
    {
        <div class="alert alert-info">@Notice</div>
    }
    @if (CanCustomizeDateRange)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@T("readings.filter.title", "Filtro periodo")</h5>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@T("dashboard.filter.from", "Data inizio")</label>
                        <InputDate class="form-control" @bind-Value="FilterFromDate" disabled="@IsApplyingFilter" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@T("dashboard.filter.to", "Data fine")</label>
                        <InputDate class="form-control" @bind-Value="FilterToDate" disabled="@IsApplyingFilter" />
                    </div>
                    <div class="col-12 col-md-4">
                        <button class="btn btn-primary w-100" @onclick="ApplyDateFilterAsync" disabled="@IsApplyingFilter">
                            @if (IsApplyingFilter)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            @T("dashboard.filter.apply", "Filtra")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="mb-4 chart-container">
        <canvas id="bpChart"></canvas>
    </div>
    <h5>@T("dashboard.morningEvening.title", "Confronto Mattino/Sera")</h5>
    <div class="mb-4 chart-container">
        <canvas id="bpMorningEveningChart"></canvas>
    </div>
    @if (!HasMorningEveningData)
    {
        <div class="alert alert-secondary mb-4">@T("dashboard.morningEvening.noData", "Nessun dato disponibile per le fasce Mattino/Sera nel periodo selezionato.")</div>
    }
    <div class="mb-4 chart-container">
        <canvas id="weightChart"></canvas>
    </div>
    <div class="mb-4 chart-container">
        <canvas id="hrChart"></canvas>
    </div>

    <h3>@T("dashboard.kpi.title", "KPI")</h3>
    <ul>
        <li>@T("dashboard.kpi.avgSystolic", "Media sistolica"): @Stats!.Kpis.AverageSystolic</li>
        <li>@T("dashboard.kpi.avgDiastolic", "Media diastolica"): @Stats!.Kpis.AverageDiastolic</li>
        <li>@T("dashboard.kpi.minMaxSystolic", "Min/Max sistolica"): @Stats!.Kpis.MinSystolic / @Stats!.Kpis.MaxSystolic</li>
        <li>@T("dashboard.kpi.minMaxDiastolic", "Min/Max diastolica"): @Stats!.Kpis.MinDiastolic / @Stats!.Kpis.MaxDiastolic</li>
    </ul>
}

@code {
    private bool IsLoading { get; set; } = true;
    private bool IsApplyingFilter { get; set; }
    private string Error { get; set; } = string.Empty;
    private string Notice { get; set; } = string.Empty;
    private DashboardStatsResponse? Stats { get; set; }
    private bool chartRenderPending;
    private LicenseType? ActiveLicenseType { get; set; }
    private DateOnly FilterFromDate { get; set; }
    private DateOnly FilterToDate { get; set; }
    private bool isLocalizationSubscribed;
    private bool CanCustomizeDateRange =>
        ActiveLicenseType is LicenseType.Advanced or LicenseType.Premium;
    private bool HasMorningEveningData =>
        Stats?.MorningEveningBloodPressureTrend.Any(x =>
            x.MorningSystolic.HasValue ||
            x.MorningDiastolic.HasValue ||
            x.EveningSystolic.HasValue ||
            x.EveningDiastolic.HasValue) == true;

    protected override async Task OnInitializedAsync()
    {
        if (!isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged += OnLanguageChanged;
            isLocalizationSubscribed = true;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        FilterFromDate = today.AddDays(-180);
        FilterToDate = today;

        try
        {
            var license = await ReadApiClient.GetLicenseAsync(CancellationToken.None);
            ActiveLicenseType = license?.Type;
            if (license?.Type == LicenseType.Free)
            {
                Notice = T("dashboard.notice.free", "Licenza Free: le statistiche sono limitate agli ultimi 30 giorni.");
            }

            var fromDate = CanCustomizeDateRange ? FilterFromDate : today.AddDays(-30);
            var toDate = CanCustomizeDateRange ? FilterToDate : today;
            await LoadDashboardAsync(fromDate, toDate);
        }
        catch
        {
            Error = T("dashboard.error.load", "Impossibile caricare la dashboard. Verifica la licenza o riprova.");
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Stats is null || !chartRenderPending)
        {
            return;
        }

        var labels = Stats.BloodPressureTrend.Select(x => x.Date.ToString("yyyy-MM-dd")).ToArray();
        var systolic = Stats.BloodPressureTrend.Select(x => x.Systolic).ToArray();
        var diastolic = Stats.BloodPressureTrend.Select(x => x.Diastolic).ToArray();

        await Js.InvokeVoidAsync("bpCharts.renderLineChart",
            "bpChart",
            labels,
            new object[]
            {
                new { label = T("readings.table.systolic", "Sistolica"), data = systolic, borderColor = "red" },
                new { label = T("readings.table.diastolic", "Diastolica"), data = diastolic, borderColor = "orange" }
            },
            T("dashboard.chart.pressureOverTime", "Pressione nel tempo"));

        var morningEveningTrend = Stats.MorningEveningBloodPressureTrend
            .Where(x =>
                x.MorningSystolic.HasValue ||
                x.MorningDiastolic.HasValue ||
                x.EveningSystolic.HasValue ||
                x.EveningDiastolic.HasValue)
            .ToArray();
        var meLabels = morningEveningTrend
            .Select(x => x.Date.ToString("yyyy-MM-dd"))
            .ToArray();
        var morningSystolic = morningEveningTrend.Select(x => x.MorningSystolic.HasValue ? (double?)x.MorningSystolic.Value : null).ToArray();
        var eveningSystolic = morningEveningTrend.Select(x => x.EveningSystolic.HasValue ? (double?)x.EveningSystolic.Value : null).ToArray();
        var morningDiastolic = morningEveningTrend.Select(x => x.MorningDiastolic.HasValue ? (double?)x.MorningDiastolic.Value : null).ToArray();
        var eveningDiastolic = morningEveningTrend.Select(x => x.EveningDiastolic.HasValue ? (double?)x.EveningDiastolic.Value : null).ToArray();

        await Js.InvokeVoidAsync("bpCharts.renderLineChart",
            "bpMorningEveningChart",
            meLabels,
            new object[]
            {
                new { label = T("dashboard.chart.morningSystolic", "Sistolica Mattino"), data = morningSystolic, borderColor = "#d9534f" },
                new { label = T("dashboard.chart.eveningSystolic", "Sistolica Sera"), data = eveningSystolic, borderColor = "#8b0000" },
                new { label = T("dashboard.chart.morningDiastolic", "Diastolica Mattino"), data = morningDiastolic, borderColor = "#f0ad4e" },
                new { label = T("dashboard.chart.eveningDiastolic", "Diastolica Sera"), data = eveningDiastolic, borderColor = "#b36b00" }
            },
            T("dashboard.morningEvening.title", "Confronto Mattino/Sera"));

        var weightTrend = Stats.WeightTrend
            .Where(x => x.Value > 0)
            .ToArray();
        var weightLabels = weightTrend.Select(x => x.Date.ToString("yyyy-MM-dd")).ToArray();
        var weightData = weightTrend.Select(x => x.Value).ToArray();

        await Js.InvokeVoidAsync("bpCharts.renderLineChart",
            "weightChart",
            weightLabels,
            new object[]
            {
                new { label = T("readings.table.weight", "Peso"), data = weightData, borderColor = "blue" }
            },
            T("dashboard.chart.weightTrend", "Trend peso"));

        var hrLabels = Stats.HeartRateTrend.Select(x => x.Date.ToString("yyyy-MM-dd")).ToArray();
        var hrData = Stats.HeartRateTrend.Select(x => x.Value).ToArray();

        await Js.InvokeVoidAsync("bpCharts.renderLineChart",
            "hrChart",
            hrLabels,
            new object[]
            {
                new { label = T("dashboard.chart.heartRate", "Heart Rate"), data = hrData, borderColor = "green" }
            },
            T("dashboard.chart.heartRateTrend", "Trend battiti"));

        chartRenderPending = false;
        if (IsApplyingFilter)
        {
            IsApplyingFilter = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyDateFilterAsync()
    {
        if (!CanCustomizeDateRange || IsApplyingFilter)
        {
            return;
        }

        if (FilterFromDate > FilterToDate)
        {
            Error = T("common.dateRangeInvalid", "La data di inizio deve essere precedente o uguale alla data di fine.");
            return;
        }

        IsApplyingFilter = true;
        Error = string.Empty;
        try
        {
            await LoadDashboardAsync(FilterFromDate, FilterToDate);
        }
        catch
        {
            Error = T("dashboard.error.load", "Impossibile caricare la dashboard. Verifica la licenza o riprova.");
            IsApplyingFilter = false;
        }
    }

    private async Task LoadDashboardAsync(DateOnly fromDate, DateOnly toDate)
    {
        var request = new StatsFilterRequest
        {
            FromDate = fromDate,
            ToDate = toDate
        };

        Stats = await StatsApiClient.GetDashboardAsync(request, CancellationToken.None);
        chartRenderPending = true;
    }

    private void OnLanguageChanged()
    {
        if (Stats is not null)
        {
            chartRenderPending = true;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged -= OnLanguageChanged;
        }
    }

    private string T(string key, string fallback) => LocalizationService.T(key, fallback);
}
