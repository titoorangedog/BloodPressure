@inject BloodPressure.Web.Services.ToastService ToastService
@implements IDisposable

<div class="toast-container">
    @foreach (var toast in ToastService.Messages)
    {
        <div class="toast-item @GetClass(toast.Level)" role="alert" aria-live="assertive" aria-atomic="true">
            <span>@toast.Message</span>
            <button type="button" class="toast-close" @onclick="() => ToastService.Remove(toast.Id)">×</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += OnChange;
    }

    private void OnChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetClass(ToastLevel level) => level switch
    {
        ToastLevel.Success => "toast-success",
        ToastLevel.Error => "toast-error",
        _ => "toast-info"
    };

    public void Dispose()
    {
        ToastService.OnChange -= OnChange;
    }
}
