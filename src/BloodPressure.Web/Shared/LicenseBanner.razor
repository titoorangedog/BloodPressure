@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@implements IDisposable
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject BloodPressure.Web.Services.LocalizationService LocalizationService
@inject AuthenticationStateProvider AuthStateProvider

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @AlertClass mb-3" role="alert">
        @Message
    </div>
}

@code {
    private string Message { get; set; } = string.Empty;
    private string AlertClass { get; set; } = "alert-secondary";
    private bool isSubscribed;
    private bool isLocalizationSubscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
            isSubscribed = true;
        }
        if (!isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged += OnLanguageChanged;
            isLocalizationSubscribed = true;
        }

        await RefreshBannerAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            var authState = await authStateTask;
            await RefreshBannerAsync(authState);
            StateHasChanged();
        });
    }

    private async Task RefreshBannerAsync(AuthenticationState? authState = null)
    {
        try
        {
            authState ??= await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Message = string.Empty;
                return;
            }

            var license = await ReadApiClient.GetLicenseAsync(CancellationToken.None);
            if (license is null)
            {
                Message = T("license.notAssigned", "Licenza: non assegnata");
                AlertClass = "alert-secondary";
                return;
            }

            var remainingDays = Math.Max(0, license.DaysRemaining);

            if (license.Type == LicenseType.Premium)
            {
                Message = TFormat("license.premiumUnlimited", "Licenza: {0} - Illimitata", license.Type);
                AlertClass = "alert-success";
                return;
            }

            if (license.IsExpired)
            {
                Message = TFormat("license.expired", "Licenza: {0} - Scaduta", license.Type);
                AlertClass = "alert-danger";
                return;
            }

            if (license.DaysRemaining <= 14)
            {
                Message = TFormat("license.expiresIn", "Licenza: {0} - Scade tra {1} giorni", license.Type, remainingDays);
                AlertClass = "alert-warning";
                return;
            }

            Message = TFormat("license.expiresIn", "Licenza: {0} - Scade tra {1} giorni", license.Type, remainingDays);
            AlertClass = "alert-success";
        }
        catch
        {
            Message = T("license.unavailable", "Licenza: non disponibile");
            AlertClass = "alert-secondary";
        }
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshBannerAsync();
            StateHasChanged();
        });
    }

    private string T(string key, string fallback) => LocalizationService.T(key, fallback);
    private string TFormat(string key, string fallbackTemplate, params object[] args) => LocalizationService.TFormat(key, fallbackTemplate, args);

    public void Dispose()
    {
        if (isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }

        if (isLocalizationSubscribed)
        {
            LocalizationService.LanguageChanged -= OnLanguageChanged;
        }
    }
}


