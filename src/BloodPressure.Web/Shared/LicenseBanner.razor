@using BloodPressure.Shared.Contracts
@using BloodPressure.Shared.Domain
@implements IDisposable
@inject BloodPressure.Web.Services.ReadApiClient ReadApiClient
@inject AuthenticationStateProvider AuthStateProvider

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert @AlertClass mb-3" role="alert">
        @Message
    </div>
}

@code {
    private string Message { get; set; } = string.Empty;
    private string AlertClass { get; set; } = "alert-secondary";
    private bool isSubscribed;

    protected override async Task OnInitializedAsync()
    {
        if (!isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
            isSubscribed = true;
        }

        await RefreshBannerAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            var authState = await authStateTask;
            await RefreshBannerAsync(authState);
            StateHasChanged();
        });
    }

    private async Task RefreshBannerAsync(AuthenticationState? authState = null)
    {
        try
        {
            authState ??= await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                Message = string.Empty;
                return;
            }

            var license = await ReadApiClient.GetLicenseAsync(CancellationToken.None);
            if (license is null)
            {
                Message = "Licenza: non assegnata";
                AlertClass = "alert-secondary";
                return;
            }

            var remainingText = LicenseCalculator.FormatRemainingItalian(DateTimeOffset.UtcNow, license.EndDateUtc);

            if (license.Type == LicenseType.Premium)
            {
                Message = $"Licenza: {license.Type} - Illimitata";
                AlertClass = "alert-success";
                return;
            }

            if (license.IsExpired)
            {
                Message = $"Licenza: {license.Type} - Scaduta";
                AlertClass = "alert-danger";
                return;
            }

            if (license.DaysRemaining <= 14)
            {
                Message = $"Licenza: {license.Type} - Scade tra {remainingText}";
                AlertClass = "alert-warning";
                return;
            }

            Message = $"Licenza: {license.Type} - Scade tra {remainingText}";
            AlertClass = "alert-success";
        }
        catch
        {
            Message = "Licenza: non disponibile";
            AlertClass = "alert-secondary";
        }
    }

    public void Dispose()
    {
        if (isSubscribed)
        {
            AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        }
    }
}


